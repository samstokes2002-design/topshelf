{
  "name": "UserPreferences",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user these preferences belong to"
    },
    "background_color": {
      "type": "string",
      "description": "App background color (hex)",
      "default": "#0B1120"
    },
    "panel_color": {
      "type": "string",
      "description": "Panel/card color (hex)",
      "default": "#131F35"
    },
    "button_color": {
      "type": "string",
      "description": "Primary button/accent color (hex)",
      "default": "#0EA5E9"
    },
    "foreground_color": {
      "type": "string",
      "enum": [
        "white",
        "black"
      ],
      "default": "white",
      "description": "App text color (white or black)"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "create": {
      "user_email": "{{user.email}}"
    },
    "read": {
      "user_email": "{{user.email}}"
    },
    "update": {
      "user_email": "{{user.email}}"
    },
    "delete": {
      "user_email": "{{user.email}}"
    }
  }
}